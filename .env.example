# =============================================================================
# Gatilho · variáveis de ambiente
#
# Copia este arquivo pra `.env.local` e preenche. NUNCA commitar o .env.local.
# Com tudo em branco, `npm run dev` abre em MODO DEMONSTRAÇÃO (banco local em
# .gatilho-demo/ e Instagram fictício): dá pra testar o painel inteiro.
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.
# =============================================================================

# ----------------------------------------------------------------- demonstração
# 1 = Instagram fictício (nada fala com a Meta). Sem Supabase, também liga o
# banco local. Em PRODUÇÃO sem Supabase o app só sobe com isto em 1.
GATILHO_DEMO=
# Opcional: segredo das sessões do banco local. Sem ele, o app sorteia um e
# guarda em .gatilho-demo/banco.json.
GATILHO_DEMO_SEGREDO=

# ------------------------------------------------------------------------- site
# Endereço público, sem barra no fim. Vai no redirect do login do Instagram e
# no link curto da DM. Ex.: https://gatilho.mxdigital.ia.br
NEXT_PUBLIC_SITE_URL=
# E-mail que aparece nos termos, na privacidade e na exclusão de dados.
NEXT_PUBLIC_EMAIL_SUPORTE=contato@mxdigital.ia.br

# --------------------------------------------------- Supabase (projeto PRÓPRIO)
# Painel do Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------- Instagram (app da Meta, login do Instagram)
# developers.facebook.com → teu app → Instagram → "API setup with Instagram
# login" → Instagram app ID e Instagram app secret (NÃO são os do Facebook).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Versão da Graph API do Instagram (a mesma que o robô do @maxwel_dev usa).
INSTAGRAM_GRAPH_VERSAO=v23.0
# 1 = NÃO pede o escopo instagram_business_manage_insights (uma permissão a
# menos na revisão da Meta; a grade de posts fica sem alcance/visualizações).
INSTAGRAM_SEM_METRICAS=
# Fase B: o token que a Meta usa pra conferir o endereço do webhook.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --------------------------------------------------------- cifra do token
# Chave AES-256 do token do Instagram (32 bytes em base64). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida todos os tokens guardados (todo mundo reconecta).
# A Edge Function da fase B precisa da MESMA chave (secret do Supabase).
GATILHO_CHAVE_TOKENS=
# Sal da impressão de quem clica no link curto (qualquer texto longo).
GATILHO_SAL_CLIQUES=

# ------------------------------------------------------------------------ cron
# A Vercel manda "Authorization: Bearer <CRON_SECRET>" no cron diário que
# renova os tokens (vercel.json). Qualquer texto longo e aleatório.
CRON_SECRET=

# -------------------------------------------------------- cobrança (fase C)
# Mercado Pago (cartão, assinatura): Suas integrações → credenciais de produção.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Asaas (Pix Automático): Integrações → Chave de API. Começar no sandbox.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# sandbox | producao
ASAAS_AMBIENTE=sandbox
